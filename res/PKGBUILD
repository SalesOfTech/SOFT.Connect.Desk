pkgname=soft-connect-desk
pkgver=1.4.9
pkgrel=1
pkgdesc="SOFT.Connect.Desk self-hosted remote support client"
arch=('x86_64')
url="https://connect.salesof.tech"
license=('AGPL-3.0-only')
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'pam' 'gst-plugins-base' 'gst-plugin-pipewire')
install=soft-connect-desk.install
options=(!strip)

package() {
  : "${SOFT_CONNECT_BUNDLE:?SOFT_CONNECT_BUNDLE is required}"
  mkdir -p "${pkgdir}/usr/share/soft-connect-desk"
  tar -xzf "${SOFT_CONNECT_BUNDLE}" \
    -C "${pkgdir}/usr/share/soft-connect-desk" \
    --strip-components=1
  mkdir -p "${pkgdir}/usr/bin"
  ln -s /usr/share/soft-connect-desk/soft-connect-desk \
    "${pkgdir}/usr/bin/soft-connect-desk"
  install -Dm 644 "${HBB}/res/rustdesk.service" \
    "${pkgdir}/usr/lib/systemd/system/soft-connect-desk.service"
  install -Dm 644 "${HBB}/res/rustdesk.desktop" \
    "${pkgdir}/usr/share/applications/soft-connect-desk.desktop"
  install -Dm 644 "${HBB}/res/rustdesk-link.desktop" \
    "${pkgdir}/usr/share/applications/soft-connect-desk-link.desktop"
  install -Dm 644 "${HBB}/res/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/soft-connect-desk.png"
}
