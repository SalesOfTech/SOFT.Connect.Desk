[Unit]
Description=SOFT.Connect.Desk
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/soft-connect-desk --service
# kill --tray and --server both
ExecStop=pkill -f "soft-connect-desk --"
# below two lines do not work, have to use above one line
#ExecStop=pkill -f "soft-connect-desk --tray"
#ExecStop=pkill -f "soft-connect-desk --server"
PIDFile=/run/soft-connect-desk.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
