+    pub(crate) async fn change_id(
+        &self,
+        old_id: &str,
+        new_id: &str,
+        uuid: &Bytes,
+    ) -> register_pk_response::Result {
+        use register_pk_response::Result::{ID_EXISTS, OK, SERVER_ERROR, UUID_MISMATCH};
+
+        let change_id_lock = self.change_id_lock.clone();
+        let _change_id_guard = change_id_lock.lock().await;
+        if let Some(new_peer) = self.get(new_id).await {
+            if new_peer.read().await.uuid != *uuid {
+                return ID_EXISTS;
+            }
+            if old_id != new_id {
+                if let Some(old_peer) = self.get(old_id).await {
+                    let same_device = old_peer.read().await.uuid == *uuid;
+                    if same_device && !Arc::ptr_eq(&old_peer, &new_peer) {
+                        if let Err(err) = self
+                            .db
+                            .delete_peer_by_id_and_uuid(old_id, uuid.as_ref())
+                            .await
+                        {
+                            log::error!("failed to remove duplicate id {}: {}", old_id, err);
+                            return SERVER_ERROR;
+                        }
+                        let mut map = self.map.write().await;
+                        if map
+                            .get(old_id)
+                            .map(|current| Arc::ptr_eq(current, &old_peer))
+                            .unwrap_or(false)
+                        {
+                            map.remove(old_id);
+                        }
+                    }
+                }
+                self.renamed_ids
+                    .write()
+                    .await
+                    .insert(old_id.to_owned(), (uuid.clone(), Instant::now()));
+            }
+            return OK;
+        }
+        let Some(peer) = self.get(old_id).await else {
+            return UUID_MISMATCH;
+        };
+        let guid = {
+            let peer = peer.read().await;
+            if peer.uuid != *uuid {
+                return UUID_MISMATCH;
+            }
+            peer.guid.clone()
+        };
+
+        if old_id == new_id {
+            return OK;
+        }
+        if self.get(new_id).await.is_some() {
+            return ID_EXISTS;
+        }
+
+        match self
+            .db
+            .change_id(&guid, old_id, new_id, uuid.as_ref())
+            .await
+        {
+            Ok(0) => UUID_MISMATCH,
+            Ok(_) => {
+                let mut map = self.map.write().await;
+                if map
+                    .get(old_id)
+                    .map(|current| Arc::ptr_eq(current, &peer))
+                    .unwrap_or(false)
+                {
+                    map.remove(old_id);
+                }
+                map.insert(new_id.to_owned(), peer);
+                drop(map);
+                self.renamed_ids
+                    .write()
+                    .await
+                    .insert(old_id.to_owned(), (uuid.clone(), Instant::now()));
+                log::info!("peer id changed: {} -> {}", old_id, new_id);
+                OK
+            }
+            Err(err) => {
+                log::error!("db.change_id failed for {} -> {}: {}", old_id, new_id, err);
+                if self.db.get_peer(new_id).await.ok().flatten().is_some() {
+                    ID_EXISTS
+                } else {
+                    SERVER_ERROR
+                }
+            }
+        }
+    }
